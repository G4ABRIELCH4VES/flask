{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Eventos",
    "version": "1.0.0",
    "description": "CRUD com Python e Flask. Os eventos são armazenados em um dicionário Python em memória RAM, usando o ID como chave. Cada evento contém id, titulo e data. O id é gerado automaticamente e não é reutilizado após exclusões; envie apenas titulo e data em POST e PUT. Os dados permanecem entre requisições e são descartados ao reiniciar o servidor. Campos de texto são aparados antes da validação. Datas passadas são permitidas."
  },
  "servers": [{"url": "http://127.0.0.1:5000", "description": "Servidor local"}],
  "tags": [{"name": "Eventos", "description": "Cadastro, consulta, atualização e remoção de eventos."}],
  "paths": {
    "/eventos": {
      "get": {
        "tags": ["Eventos"],
        "summary": "Listar eventos ordenados por data",
        "description": "Ordenação crescente por data, com desempate por ID. Retorna uma lista vazia quando não há eventos.",
        "operationId": "listarEventos",
        "responses": {
          "200": {
            "description": "Lista de eventos.",
            "content": {
              "application/json": {
                "schema": {"type": "array", "items": {"$ref": "#/components/schemas/Evento"}},
                "example": []
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Eventos"],
        "summary": "Cadastrar um evento",
        "operationId": "cadastrarEvento",
        "requestBody": {"$ref": "#/components/requestBodies/DadosEvento"},
        "responses": {
          "201": {
            "description": "Evento cadastrado.",
            "headers": {
              "Location": {
                "description": "Rota para consultar o evento criado.",
                "schema": {"type": "string", "example": "/eventos/1"}
              }
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Evento"}}}
          },
          "400": {"$ref": "#/components/responses/DadosInvalidos"},
          "413": {"$ref": "#/components/responses/CorpoMuitoGrande"},
          "415": {"$ref": "#/components/responses/TipoIncorreto"}
        }
      }
    },
    "/eventos/{id}": {
      "parameters": [{"$ref": "#/components/parameters/EventoId"}],
      "get": {
        "tags": ["Eventos"],
        "summary": "Consultar um evento pelo ID",
        "operationId": "consultarEvento",
        "responses": {
          "200": {
            "description": "Evento encontrado.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Evento"}}}
          },
          "404": {"$ref": "#/components/responses/NaoEncontrado"}
        }
      },
      "put": {
        "tags": ["Eventos"],
        "summary": "Atualizar um evento",
        "description": "Substitui o titulo e a data de um evento existente. Ambos são obrigatórios. O id permanece o mesmo. Não cria um novo evento.",
        "operationId": "atualizarEvento",
        "requestBody": {"$ref": "#/components/requestBodies/DadosEvento"},
        "responses": {
          "200": {
            "description": "Evento atualizado.",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Evento"}}}
          },
          "400": {"$ref": "#/components/responses/DadosInvalidos"},
          "404": {"$ref": "#/components/responses/NaoEncontrado"},
          "413": {"$ref": "#/components/responses/CorpoMuitoGrande"},
          "415": {"$ref": "#/components/responses/TipoIncorreto"}
        }
      },
      "delete": {
        "tags": ["Eventos"],
        "summary": "Remover um evento (rota alternativa no plural)",
        "operationId": "removerEventoPlural",
        "responses": {
          "204": {"description": "Evento removido. A resposta não tem corpo."},
          "404": {"$ref": "#/components/responses/NaoEncontrado"}
        }
      }
    },
    "/evento/{id}": {
      "parameters": [{"$ref": "#/components/parameters/EventoId"}],
      "delete": {
        "tags": ["Eventos"],
        "summary": "Remover um evento",
        "operationId": "removerEvento",
        "responses": {
          "204": {"description": "Evento removido. A resposta não tem corpo."},
          "404": {"$ref": "#/components/responses/NaoEncontrado"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "EventoId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "ID do evento. Identificadores inválidos ou inexistentes retornam 404.",
        "schema": {"type": "integer", "format": "int64", "minimum": 1, "maximum": 9223372036854775807},
        "example": 1
      }
    },
    "schemas": {
      "EventoEntrada": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titulo", "data"],
        "properties": {
          "titulo": {"type": "string", "minLength": 1, "maxLength": 150, "description": "Título não vazio após remover os espaços nas extremidades."},
          "data": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Data existente no formato AAAA-MM-DD."}
        }
      },
      "Evento": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "titulo", "data"],
        "properties": {
          "id": {"type": "integer", "format": "int64", "minimum": 1, "readOnly": true},
          "titulo": {"type": "string", "minLength": 1, "maxLength": 150},
          "data": {"type": "string", "format": "date"}
        },
        "example": {"id": 1, "titulo": "Encontro Flask", "data": "2026-12-05"}
      },
      "Erro": {
        "type": "object",
        "required": ["erro"],
        "additionalProperties": false,
        "properties": {
          "erro": {"type": "string"},
          "campos": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Detalhes por campo quando houver erro de validação."}
        }
      }
    },
    "requestBodies": {
      "DadosEvento": {
        "required": true,
        "description": "Objeto JSON com titulo e data obrigatórios. O id é gerado automaticamente e não deve ser enviado. Campos desconhecidos, valores null e tipos diferentes de texto são rejeitados. Limite do corpo: 64 KB.",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/EventoEntrada"},
            "examples": {
              "encontroFlask": {
                "summary": "Encontro Flask",
                "value": {"titulo": "Encontro Flask", "data": "2026-12-05"}
              },
              "oficinaPython": {
                "summary": "Oficina de Python",
                "value": {"titulo": "Oficina de Python", "data": "2026-12-12"}
              }
            }
          }
        }
      }
    },
    "responses": {
      "DadosInvalidos": {
        "description": "JSON malformado ou erro de validação: campos obrigatórios, tipos incorretos, campos desconhecidos, limites excedidos ou datas inválidas.",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/Erro"},
            "examples": {
              "validacao": {"value": {"erro": "Dados inválidos.", "campos": {"titulo": "Campo obrigatório.", "data": "Informe uma data válida no formato AAAA-MM-DD."}}},
              "jsonInvalido": {"value": {"erro": "JSON inválido. Envie um corpo JSON bem formado."}}
            }
          }
        }
      },
      "NaoEncontrado": {
        "description": "Evento inexistente ou ID inválido.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Erro"}, "example": {"erro": "Recurso não encontrado."}}}
      },
      "CorpoMuitoGrande": {
        "description": "O corpo da requisição excede 64 KB.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Erro"}, "example": {"erro": "O corpo da requisição excede o limite de 64 KB."}}}
      },
      "TipoIncorreto": {
        "description": "A requisição deve enviar Content-Type: application/json.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Erro"}, "example": {"erro": "Envie o corpo com Content-Type application/json."}}}
      }
    }
  }
}
